# SQLite file for the curator. This is not the Good Dog database.
DATABASE_URL=./data/curator.db

# Session signing secret. Use at least 16 random characters.
AUTH_SECRET=replace-with-a-long-random-string

# First curator account, created by npm run db:seed or on first boot if none exist.
CURATOR_EMAIL=curator@example.com
CURATOR_PASSWORD=replace-with-a-private-password
CURATOR_NAME=Curator

# Optional. Playlist import uses the YouTube Data API when this is set.
# Without it, use manual video URLs, a metadata file, or the labelled fixture.
# YOUTUBE_API_KEY=

# Optional OpenAI-compatible chat API for semantic matching.
# Manual curation and deterministic matching work without these.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional path to a Good Dog checkout, used only by npm run curriculum:extract.
# GOOD_DOG_PATH=
